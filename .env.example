# Copy to .env for local use, or set these in your host's dashboard.
# Atlas: Connect > Drivers > copy the connection string and put your DB user's password in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hangeul

# Protects the app. Strongly recommended once it is online.
APP_PASSWORD=choose-a-long-passphrase
# Optional: a separate secret for signing the login token (defaults to APP_PASSWORD).
# TOKEN_SECRET=
